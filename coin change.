#include <stdio.h>

int main() {
    int V, N;
    scanf("%d %d", &V, &N);

    int coins[N];

    for (int i = 0; i < N; i++)
        scanf("%d", &coins[i]);

    int dp[V + 1];

    for (int i = 0; i <= V; i++)
        dp[i] = 999999;

    dp[0] = 0;

    for (int i = 1; i <= V; i++) {
        for (int j = 0; j < N; j++) {

            if (coins[j] <= i) {
                if (dp[i - coins[j]] + 1 < dp[i])
                    dp[i] = dp[i - coins[j]] + 1;
            }
        }
    }

    if (dp[V] == 999999)
        printf("-1");
    else
        printf("%d", dp[V]);

    return 0;
}
